# Copy this file to .env and replace placeholders with your own values.
# Never commit the real .env file or put tokens in source code.

DISCORD_TOKEN=your_discord_bot_token_here
PREFIX=/
DEVELOPER_ID=
REPORT_CHANNEL_ID=
FEEDBACK_CHANNEL_ID=
HEAVY_THRESHOLD=1.5
HEAVY_COGS_PATH=data/heavy_cogs.json

# Health monitoring and administrator alerts.
# Configure a Discord text channel and/or comma-separated admin user IDs.
HEALTH_ALERT_CHANNEL_ID=
HEALTH_ADMIN_USER_IDS=
HEALTH_CHECK_INTERVAL_SECONDS=60
HEALTH_FAILURE_THRESHOLD=2

# Central application logging.
# Logs are written to stdout/stderr and to a rotating UTF-8 file.
LOG_LEVEL=INFO
LOG_FILE=logs/gakuseibot.log
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=5

# Optional HSS timetable integration.
# The project runtime is standardized on Python 3.12.
# Set true to install HSS.py into the Docker image.
INSTALL_HSS=false
HSS_API_TOKEN=
HSS_SCHOOL_ID=
HSS_GRADE=
HSS_CLASS=
