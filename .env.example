# Copy this file to .env and replace placeholders with your own values.
# Never commit the real .env file or put bot tokens in source code.

# Required
DISCORD_TOKEN=your_discord_bot_token_here

# Optional command and developer configuration
PREFIX=/
DEVELOPER_ID=
REPORT_CHANNEL_ID=
FEEDBACK_CHANNEL_ID=

# Optional Cog loading configuration
HEAVY_THRESHOLD=1.5
HEAVY_COGS_PATH=data/heavy_cogs.json
