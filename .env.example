# Copy this file to .env and replace placeholders with your own values.
# Never commit the real .env file or put tokens in source code.

DISCORD_TOKEN=your_discord_bot_token_here
PREFIX=/
DEVELOPER_ID=
REPORT_CHANNEL_ID=
FEEDBACK_CHANNEL_ID=
HEAVY_THRESHOLD=1.5
HEAVY_COGS_PATH=data/heavy_cogs.json

# Optional HSS timetable integration.
# Python 3.11+ is required. Set true to install HSS.py into the Docker image.
INSTALL_HSS=false
HSS_API_TOKEN=
HSS_SCHOOL_ID=
HSS_GRADE=
HSS_CLASS=
