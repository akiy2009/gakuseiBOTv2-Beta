# gakuseiBOTv2 環境変数設定例
# このファイルをコピーして .env という名前で保存し、実際の値を設定してください

# Discord Bot設定
DISCORD_TOKEN=your_discord_bot_token_here
PREFIX=/

# 開発者・管理者設定
DEVELOPER_ID=your_discord_user_id_here
REPORT_CHANNEL_ID=your_report_channel_id_here
FEEDBACK_CHANNEL_ID=your_feedback_channel_id_here

# サイト・サービス設定
OFFICIAL_WEBSITE=https://gakuseibot.com
DASHBOARD_URL=https://dashboard.gakuseibot.com
GITHUB_REPO=https://github.com/akiy2009/gakuseiBOTv2-Beta
SUPPORT_SERVER_INVITE=https://discord.gg/9x3FwmPxhP

# データベース設定 (必要に応じて)
DATABASE_URL=sqlite:///data/bot.db

# デバッグ設定
DEBUG=false
LOG_LEVEL=INFO